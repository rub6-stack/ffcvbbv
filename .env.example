# Telegram bot (via @BotFather) en het chat/group ID waar alerts naartoe gaan
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=-1001234567890

# Optioneel: voor holder-aantallen. Vereist meestal een betaald
# Etherscan/BscScan Pro-abonnement (zie README).
ETHERSCAN_API_KEY=

# Welke chains scannen, comma separated: eth,bsc
SCAN_CHAINS=eth,bsc

# Marketcap-drempels in USD waarop een Telegram-alert wordt gestuurd
MC_THRESHOLDS=10000,50000

# Negeer pools met minder dan dit bedrag aan liquiditeit (USD), tegen scams/noise
MIN_LIQUIDITY_USD=1000

# Hoe vaak scannen, in seconden
POLL_INTERVAL_SECONDS=60

STATE_FILE=state.json
STATE_MAX_AGE_DAYS=14
